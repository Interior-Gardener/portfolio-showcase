# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# --- Render Production ---
# Set this to node-server on Render to ensure a Node.js compatible production build
NITRO_PRESET=node-server

# --- Razorpay (test keys work for development) ---
# Get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- MongoDB (local / Atlas SRV connection string) ---
# Used by the native driver when running locally (`bun run dev`, `bun run build`).
# Format: mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=portfolio
MONGODB_COLLECTION=donations

# --- MongoDB Atlas Data API (optional; used when deployed to the edge) ---
# The edge/Worker runtime cannot open raw TCP sockets, so deployments use the
# HTTPS Data API instead. Leave blank for purely local development.
MONGODB_DATA_API_URL=
MONGODB_DATA_API_KEY=
MONGODB_DATA_SOURCE=Cluster0

# --- Site ---
VITE_SITE_URL=
